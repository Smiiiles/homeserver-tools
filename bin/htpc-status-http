#!/usr/bin/env python3
import json, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
class H(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            s = subprocess.run(["/usr/local/bin/htpc-status"], capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            s = "TV: unknown | Playing: unknown | On screen: unknown"
        d = {"text": s}
        for part in s.split(" | "):
            k, _, v = part.partition(": ")
            d[k.lower().replace(" ", "_")] = v
        b = json.dumps(d).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)
    def log_message(self, *a):
        pass
ThreadingHTTPServer(("0.0.0.0", 8099), H).serve_forever()
