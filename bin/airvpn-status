#!/usr/bin/env python3
import json, sys, urllib.request
cc = (sys.argv[1] if len(sys.argv) > 1 else "se").lower()
data = json.load(urllib.request.urlopen("https://airvpn.org/api/status/", timeout=15))
rows = [s for s in data["servers"] if s.get("country_code", "").lower() == cc]
rows.sort(key=lambda s: s.get("currentload", 999))
print(f"{'server':<16}{'location':<12}{'load%':>6}{'users':>7}{'bw/max Mbit':>16}  health")
for s in rows:
    bw = f"{s.get('bw', '')}/{s.get('bw_max', '')}"
    print(f"{s.get('public_name', ''):<16}{s.get('location', ''):<12}{s.get('currentload', ''):>6}{s.get('users', ''):>7}{bw:>16}  {s.get('health', '')}")
